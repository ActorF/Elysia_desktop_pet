{
  "name": "elysia_desktop_pet",
  "productName": "爱莉希雅桌宠",
  "version": "1.4.1",
  "private": true,
  "description": "独立爱莉希雅桌面伙伴",
  "author": "ActorF",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "package": "electron-builder --dir",
    "make:portable": "node scripts/package-release.cjs --portable",
    "make:setup": "node scripts/package-release.cjs --setup",
    "make:release": "node scripts/package-release.cjs",
    "test:smoke": "node scripts/launch.cjs --smoke-test",
    "test:visual": "node scripts/visual-check.cjs",
    "test:faces": "node scripts/face-integrity-check.cjs",
    "preview:expressions": "node scripts/gallery-preview.cjs",
    "preview:motion": "node scripts/gallery-preview.cjs --motion",
    "test:zoom": "node scripts/tray-zoom-check.cjs",
    "test:settings": "node scripts/settings-window-check.cjs",
    "test:voice": "node scripts/launch.cjs --voice-smoke-test",
    "test:interactions": "node scripts/interactions-check.cjs",
    "test:interaction-settings": "node scripts/launch.cjs --interaction-smoke-test",
    "test:chat": "node scripts/chat-window-check.cjs",
    "test:chat-native": "node scripts/launch.cjs --chat-smoke-test",
    "test:chat-model": "node scripts/chat-model-check.cjs",
    "test:chat-tts": "node scripts/chat-tts-check.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "prepare:voice": "node scripts/package-voice-bootstrap.cjs",
    "verify:release": "node scripts/verify-package.cjs",
    "verify:setup": "node scripts/verify-setup.cjs"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.actorf.elysia.standalonepet",
    "productName": "爱莉希雅桌宠",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/character/*.png",
      "assets/ui/tray-icon.png",
      "package.json",
      "LICENSE",
      "ASSET-NOTICE.md"
    ],
    "extraResources": [
      {
        "from": "build-resources/voice-bootstrap/Elysia-voice-assets-v1.zip",
        "to": "Elysia-voice-assets-v1.zip"
      },
      {
        "from": "build-resources/voice-bootstrap/tools",
        "to": "tools",
        "filter": ["7za.exe", "LICENSE.txt", "COPYING"]
      },
      {
        "from": "assets/voice",
        "to": "voice",
        "filter": ["final-audio-map.json", "audio-final/*.wav"]
      },
      {
        "from": "assets/interaction-voice",
        "to": "interaction-voice",
        "filter": ["final-audio-map.json", "audio-final/*.wav"]
      }
    ],
    "asarUnpack": [
      "electron/chat-tts-worker.py",
      "electron/legacy-hotkeys.ps1",
      "electron/typed-keys.ps1",
      "electron/taskbar-order.ps1",
      "electron/voice-environment.ps1"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/ui/app-icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "Elysia_desktop_pet-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/ui/app-icon.ico",
      "uninstallerIcon": "assets/ui/app-icon.ico",
      "installerHeaderIcon": "assets/ui/app-icon.ico",
      "artifactName": "Elysia_desktop_pet-${version}-setup.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ActorF/Elysia_desktop_pet.git"
  },
  "homepage": "https://github.com/ActorF/Elysia_desktop_pet#readme",
  "bugs": {
    "url": "https://github.com/ActorF/Elysia_desktop_pet/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
